/*
 * QuickJS shared types module
 *
 * This module includes quickjs.h and other shared headers to define types
 * once, so that other modules can `use quickjs_types::*` to import them
 * without creating duplicate nominal types.
 */

use libc::{malloc, free, realloc, calloc, abort, exit, printf, fprintf, snprintf, vsnprintf, memcpy, memmove, memset, strlen, strcmp, strchr, strrchr, strstr, strtod, size_t, intptr_t, uint8_t, uint16_t, uint32_t, uint64_t, FILE, stdout, int32_t};

typedef list::list_head list_head;

#if !defined(_MSC_VER)
#include <sys/time.h>
#if defined(_WIN32)
#include <timezoneapi.h>
#endif
#endif
#if defined(_WIN32)
#include <intrin.h>
#endif
#include <time.h>
#include <math.h>
#include <assert.h>

#include "cutils.h"
#include "list.h"
#include "quickjs_macros.h"
#include "libregexp.h"
#include "dtoa.h"
